# ==========================================
# BidPilot Project .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Production & Standalone Releases
/.vercel
/.netlify

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs & Diagnostics
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage
/.nyc_output
*.lcov

# IDEs & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iws
*.iml
*.ipr
.fleet/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary Files & Lock File Fallbacks
/tmp
/scratch
*.tmp
*.bak
*.swp
*.swo
